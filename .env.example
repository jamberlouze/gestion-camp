# Copier vers .env.local (non versionné). DEV : base Supabase locale
# (npm run db:start ; la clé publique s'affiche au démarrage). Jamais la PROD
# ici : ses valeurs sont dans .env.production.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
