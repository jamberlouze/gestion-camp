// Waker Supabase (Cloudflare Worker, sans site). L'application elle-même est
// publiée par Cloudflare Pages ; ce Worker ne sert qu'à garder Supabase éveillé.
// Déploiement : `npm run waker:deploy` depuis la racine du dépôt.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "gestion-camp-waker",
  "main": "index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "triggers": {
    // Quatre fois par jour (Supabase veut « quelques requêtes chaque jour »).
    "crons": ["0 2,8,14,20 * * *"]
  },
  // Valeurs publiques (la clé « publishable » est faite pour être exposée ;
  // la même se retrouve dans le code du site). Supabase > Project Settings > API Keys.
  "vars": {
    "SUPABASE_URL": "https://nurjzafcogzgekquzuwh.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_x8nstxT1q6UT9ZAm2N6zTA_woykXT1y"
  },
  "observability": { "enabled": true }
}
