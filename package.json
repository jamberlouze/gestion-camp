{
  "name": "gestion-camp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "db:push": "supabase db push",
    "db:config": "supabase config push",
    "db:types": "supabase gen types typescript --linked --schema core,embarcations,commande,horaire > src/lib/database.types.ts",
    "import:essai": "node scripts/migration/importer.mjs --essai",
    "import": "node scripts/migration/importer.mjs",
    "waker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "import:sauvegarder": "node scripts/migration/importer.mjs --sauvegarder"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.103.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "supabase": "^2.117.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.140.0"
  }
}
