{
  "name": "gestion-camp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "db:start": "SUPABASE_AUTH_EMAIL_SMTP_ENABLED=false SUPABASE_AUTH_SITE_URL=http://localhost:5173 supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "prod:db:push": "supabase db push --linked",
    "prod:db:config": "supabase config push",
    "db:types": "supabase gen types typescript --local --schema core,embarcations,commande,horaire,mastertimeline,subventions,vigie,calendrier,temps,vehicules,travaux,achats,rooming,caisse > src/lib/database.types.ts",
    "import:essai": "node scripts/migration/importer.mjs --essai",
    "import": "node scripts/migration/importer.mjs",
    "import:sauvegarder": "node scripts/migration/importer.mjs --sauvegarder",
    "deploy": "npm run build && wrangler deploy",
    "test:worker": "node --test \"worker/**/*.test.js\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@supabase/supabase-js": "^2.117.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/query-sync-storage-persister": "^5.104.0",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-query-persist-client": "^5.104.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "tailwindcss": "^4.3.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "supabase": "^2.117.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.140.0"
  }
}
